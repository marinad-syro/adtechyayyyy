{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "app": {
      "entrypoint": "api/index.py",
      "routePrefix": "/",
      "framework": "fastapi",
      "maxDuration": 60,
      "includeFiles": [
        "frontend/**",
        "backend/agent/**",
        "backend/data/*.json"
      ],
      "excludeFiles": [
        "backend/model_cache/**",
        "backend/**/*.db",
        "backend/brain_regions.py",
        "**/__pycache__/**",
        "**/.venv/**"
      ]
    }
  }
}
