{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python scripts/vercel_build.py",
  "experimentalServices": {
    "app": {
      "entrypoint": "app.py",
      "routePrefix": "/",
      "framework": "fastapi",
      "maxDuration": 60,
      "includeFiles": ["backend/**", "_frontend/**", "public/**", "app.py"],
      "excludeFiles": [
        "backend/model_cache/**",
        "backend/**/*.db",
        "backend/brain_regions.py",
        "**/__pycache__/**",
        "**/.venv/**"
      ]
    }
  }
}
